{
  "name": "@moonlight/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Moonlight desktop — Electron app targeting Windows (and incidentally Linux/macOS).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:win": "electron-vite build && electron-builder --win",
    "build:win:portable": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@moonlight/core": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  },
  "build": {
    "appId": "com.kameron.moonlight",
    "productName": "Moonlight",
    "files": ["out/**/*"],
    "win": {
      "target": ["portable", "nsis"]
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    }
  }
}
